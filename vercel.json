{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    { "source": "/privacy-policy", "destination": "/index.html" },
    { "source": "/terms-and-conditions", "destination": "/index.html" },
    { "source": "/shipping-policy", "destination": "/index.html" },
    { "source": "/refund-policy", "destination": "/index.html" },
    { "source": "/return-policy", "destination": "/index.html" }
  ]
}
