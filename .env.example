# ===================================================
# TEE MATRIX — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# Never commit the .env file to version control.
# ===================================================

# Port to run the server on (default: 5173)
PORT=5173

# --- 1. RAZORPAY CONFIGURATION ---
# Found in: Razorpay Dashboard -> Settings -> API Keys
# Test Key format: rzp_test_... | Live Key format: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_TSNOwRfNZPmZmS
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Found in: Razorpay Dashboard -> Settings -> Webhooks
# Set Webhook URL to: https://your-domain.com/api/razorpay-webhook
# Active events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- 2. SUPABASE CONFIGURATION ---
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://gqjpwnxnloltfzpqqipi.supabase.co

# Secret service-role key (Project Settings -> API -> Project API Keys -> service_role secret)
# Required for server-side authoritative pricing, RLS bypass, and atomic stock decrements
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- 3. CORS & ORIGIN ALLOWLIST ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
