# ===================================================
# TEE MATRIX — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# Never commit the .env file to version control.
# ===================================================

# Port to run the server on (default: 5173)
PORT=5173

# --- 1. RAZORPAY CONFIGURATION ---
# Found in: Razorpay Dashboard -> Settings -> API Keys
# Test Key format: rzp_test_... | Live Key format: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Found in: Razorpay Dashboard -> Settings -> Webhooks
# Webhook URL must point at the Node host directly (Render), NOT through the Vercel proxy —
# the signature is an HMAC over raw request bytes and a proxy may re-encode the body.
#   https://<your-render-host>.onrender.com/api/razorpay-webhook
# Active events: payment.captured, order.paid  (these are the only two the server handles)
# This is a value you invent, not a Razorpay-issued key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- 2. SUPABASE CONFIGURATION ---
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://gqjpwnxnloltfzpqqipi.supabase.co

# Secret service-role key (Project Settings -> API -> Project API Keys -> service_role secret)
# Required for server-side authoritative pricing, RLS bypass, and atomic stock decrements.
# Never expose this to the browser or place it in any file under js/.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- 3. CORS & ORIGIN ALLOWLIST ---
# Comma-separated list of allowed origins. In production this must be the public site origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- 4. MERCHANT UPI ---
# Your PhonePe/bank merchant VPA, e.g. Q1234567890@ybl
# Hosts with an ephemeral filesystem (Render, Fly, Vercel) wipe data/payment_config.json on
# every redeploy, so this env var — not the file — is what keeps UPI QR codes pointed at the
# real account. If unset, the server warns at boot and falls back to a placeholder VPA that
# you do not own; Razorpay and COD checkout still work.
MERCHANT_UPI_VPA=

# --- 5. AUTHORIZED ADMIN EMAILS ---
# Comma-separated list of Google / Gmail accounts authorized for Admin Panel access.
# When logging in via "Sign in with Google" at /#admin, the server checks the verified
# Google email against this list.
ADMIN_EMAILS=teematrixsupport@gmail.com,dilshad29052003@gmail.com

